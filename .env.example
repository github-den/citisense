# Copy this file to .env and fill in the deployment credentials.

# Required: Supabase project credentials.
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com

# Server-side only. Required for local seed scripts that create Auth users.
# Never expose this in frontend code and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Required: Google login/signup.
# Use the same OAuth client configured in Supabase Authentication -> Providers -> Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: enables AI-powered feedback flagging and feedbox matching.
# Keep this server-side only. Do not prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Temporary demo access for presentation/dev only.
# Keep this false or unset for production.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
